versions.tf
---
terraform {
  required_version = ">= 1.3.0"

  required_providers {
    azurerm = {
      source  = "hashicorp/azurerm"
      version = "~> 3.100"
    }
  }
}


main.tf
---
provider "azurerm" {
  features {}
}

resource "azurerm_cdn_profile" "this" {
  name                = var.cdn_profile_name
  resource_group_name = var.resource_group_name
  location            = var.location
  sku                 = var.pricing_tier

  tags = var.tags
}


outputs.tf
---
output "cdn_profile_id" {
  description = "ID of the CDN profile"
  value       = azurerm_cdn_profile.this.id
}

output "cdn_profile_name" {
  description = "Name of the CDN profile"
  value       = azurerm_cdn_profile.this.name
}


variables.tf
---
variable "cdn_profile_name" {
  description = "The name of the CDN profile"
  type        = string
}

variable "subscription_id" {
  description = "Azure Subscription ID"
  type        = string
}

variable "resource_group_name" {
  description = "Resource group where CDN profile will be created"
  type        = string
}

variable "location" {
  description = "Azure region for the CDN profile"
  type        = string
  default     = "East US"
}

variable "pricing_tier" {
  description = <<EOF
Available CDN SKU options:
- Standard_Verizon
- Premium_Verizon
- Standard_Akamai
- Standard_Microsoft  (Recommended)
EOF
  type = string
}

variable "tags" {
  description = "Tags to assign to the CDN profile"
  type        = map(string)
  default     = {}
}



backend.tf
---
terraform {
  backend "azurerm" {
    resource_group_name  = "tfstate-rg"
    storage_account_name = "tfstatebackend001"
    container_name       = "tfstate"
    key                  = "cdn-profile/terraform.tfstate"
  }
}


env/dev.tfvars
---
# ===========================
# CDN PRICING TIER OPTIONS
# ===========================
# Available CDN SKU Options:
# - Standard_Verizon
# - Premium_Verizon
# - Standard_Akamai
# - Standard_Microsoft   (Recommended for most use cases)
# - Premium_ChinaCdn
# ===========================

cdn_profile_name     = "dev-cdn-profile"
subscription_id      = "YOUR_DEV_SUBSCRIPTION_ID"
resource_group_name  = "dev-rg"
location             = "East US"

# Select the pricing tier from the options above
pricing_tier         = "Standard_Microsoft"

tags = {
  environment = "dev"
  department  = "IT"
}



env/qa.tfvars
---
cdn_profile_name     = "qa-cdn-profile"
subscription_id      = "YOUR_QA_SUBSCRIPTION_ID"
resource_group_name  = "qa-rg"
location             = "Central India"
pricing_tier         = "Standard_Microsoft"

tags = {
  environment = "qa"
  department  = "IT"
}


How to Run?
For Dev:
terraform init
terraform plan -var-file="env/dev.tfvars"
terraform apply -var-file="env/dev.tfvars"


For QA:
terraform init
terraform plan -var-file="env/qa.tfvars"
terraform apply -var-file="env/qa.tfvars"
